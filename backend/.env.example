# Django Settings — COPY to .env and fill in real values. NEVER commit .env.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-strong-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — NEVER commit real passwords.
DB_NAME=gceok_mis
DB_USER=gceok_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (seconds)
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=604800

# PII field encryption (Fernet key). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-fernet-key

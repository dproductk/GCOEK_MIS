# Django Settings — COPY to .env and fill in real values. NEVER commit .env.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-strong-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — NEVER commit real passwords.
DB_NAME=gceok_mis
DB_USER=gceok_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (seconds)
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=604800

# PII field encryption (Fernet key). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-fernet-key

# Easebuzz Online Payment Gateway (get real values from Easebuzz dashboard)
EASEBUZZ_ENABLED=True
EASEBUZZ_ENV=sandbox
EASEBUZZ_KEY=change-me
EASEBUZZ_SALT=change-me
EASEBUZZ_SUB_MERCHANT_ID=
EASEBUZZ_TIMEOUT=5
# Mock checkout ONLY for local testing. Always False in production.
EASEBUZZ_MOCK_MODE=False
# Comma-separated Easebuzz server IPs for webhook. Empty = allow all (dev only).
EASEBUZZ_WEBHOOK_ALLOWED_IPS=
FRONTEND_BASE_URL=http://localhost:5173

# Email (console = log only, smtp = real mail)
EMAIL_ENABLED=True
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=accounts@gceok.ac.in
EMAIL_FROM_NAME=GCOEK Accounts Desk
